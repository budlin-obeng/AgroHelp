# AgroHelp Environment Configuration Example
# Copy this file to .env and customize for your local setup

# ---------------------------------------------
# Backend Service Configuration (FastAPI)
# ---------------------------------------------
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------------------------------------------
# Data Pipeline & Space2Soil Dataset Paths
# ---------------------------------------------
# Path to 10-year processed NASA datasets (relative to backend/ or absolute)
SPACE2SOIL_DATA_DIR=../Space2Soil/data/processed
# Optional ML Model Artifact (Scikit-Learn Joblib/Pickle)
ML_MODEL_PATH=../Space2Soil/models/rotation_model.joblib

# ---------------------------------------------
# Frontend Service Configuration (Vite/React)
# ---------------------------------------------
# Frontend base URL connecting to backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------
# NASA Earthdata & Remote API Keys (Optional for Ingestion/Updates)
# ---------------------------------------------
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
